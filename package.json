    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "openai": "^6.49.0",
