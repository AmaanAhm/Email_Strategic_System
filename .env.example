# --- Database & queue (docker-compose defaults) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/email_outreach"
REDIS_URL="redis://localhost:6379"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Google Cloud OAuth 2.0 Web application credentials (see README)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- OpenAI (AI email rewriting) ---
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.5"

# --- App ---
UPLOAD_DIR="./uploads"
APP_URL="http://localhost:3000"
