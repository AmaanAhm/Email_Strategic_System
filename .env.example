# --- Database & queue (docker-compose defaults) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/email_outreach"
REDIS_URL="redis://localhost:6379"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Google Cloud OAuth 2.0 Web application credentials (see README)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Anthropic (AI email rewriting) ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-8"

# --- App ---
UPLOAD_DIR="./uploads"
APP_URL="http://localhost:3000"
